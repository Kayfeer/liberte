# Copy to .env. Never commit credentials.
INSTANCE_NAME=Liberte Node
PREMIUM_REQUIRED=false
# Empty disables the administrator API. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=
PAYMENT_SERVER_PUBKEY=
REGISTRATION_OPEN=true
MAX_PEERS=100
PUBLIC_RELAY_ADDR=
MAX_BLOB_SIZE=52428800
MAX_USER_BYTES=262144000
MAX_TOTAL_BYTES=1073741824
MAX_OBJECTS=10000
MAX_REPLAY_ENTRIES=10000
MAX_HTTP_CONCURRENCY=2
RUST_LOG=liberte=info,libp2p=warn
# The HTTP API is loopback-only on the host by default. Use an HTTPS proxy for remote clients.
HTTP_BIND=127.0.0.1

# Only used when explicitly adding docker-compose.turn.yml.
# Use a public server with matching DNS/firewall rules. Do not reuse an account password.
TURN_REALM=
TURN_PUBLIC_IP=
TURN_USERNAME=
TURN_PASSWORD=

# Optional SFU: all three values must be present, or all empty.
# This is the URL clients reach, not the Docker service hostname.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only used when explicitly adding docker-compose.livekit.yml.
# Set the public IPv4 address advertised for media and configure matching firewall/NAT rules.
LIVEKIT_NODE_IP=
LIVEKIT_HTTP_BIND=127.0.0.1

